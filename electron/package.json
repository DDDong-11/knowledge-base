{
  "name": "kb-electron",
  "version": "0.1.0",
  "private": true,
  "description": "个人开发知识库 - Electron 视图层",
  "main": "dist/main/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "npm run build && node --test \"dist/main/**/*.test.js\" && vitest run",
    "test:renderer": "vitest run",
    "start": "npm run build && electron .",
    "dev:renderer": "vite",
    "gen-icon": "node scripts/gen-tray-icon.mjs",
    "package-kernel": "cd ../java-kernel && ./mvnw -DskipTests package"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^33.2.0",
    "jsdom": "^30.1.3",
    "typescript": "^5.7.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
